# ==========================================================================
# Ibra X — contoh konfigurasi lingkungan
# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env.
# ==========================================================================

# --- Provider LLM (pilih minimal satu; bisa banyak sekaligus) ---------------
# Format umum: <PROVIDER>_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Endpoint OpenAI-compatible kustom (opsional)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Ollama lokal (tanpa API key)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- Pencarian web (opsional; pilih salah satu) ----------------------------
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# --- Agen default ----------------------------------------------------------
IBRA_PROVIDER=openrouter
IBRA_MODEL=anthropic/claude-sonnet-4.5
IBRA_TEMPERATURE=0.3
IBRA_MAX_STEPS=16
IBRA_MAX_TOKENS_PER_TURN=8000

# --- Server ----------------------------------------------------------------
IBRA_PORT=8787
IBRA_HOST=127.0.0.1
# Kunci untuk mengakses API HTTP lokal (kosongkan untuk menonaktifkan proteksi)
IBRA_API_TOKEN=

# --- Keamanan --------------------------------------------------------------
# Nomor/ID yang boleh berinteraksi dengan agen (pisahkan dengan koma).
# Kosongkan untuk mode "owner-only" (hanya chat milik sendiri).
IBRA_ALLOWLIST=
# Tingkat otonomi: readonly | suggest | auto | autonomous
IBRA_AUTONOMY=suggest

# Transkripsikan pesan suara otomatis (butuh provider yang mendukung audio)
IBRA_TRANSCRIBE=false

# Deskripsikan gambar masuk otomatis (butuh model multimodal)
IBRA_DESCRIBE_IMAGES=false

# Aktifkan balasan suara (TTS) untuk tool wa_send_voice
IBRA_SPEAK=false

# --- Batas & jam tenang ----------------------------------------------------
# Jam tenang (agen tidak membalas otomatis), format "HH:MM-HH:MM"
IBRA_QUIET_HOURS=
# Batas laju (0 = tanpa batas)
IBRA_RATE_PER_SENDER=20
IBRA_RATE_PER_CHAT=30
# Usia maksimum pesan (detik) agar masih dibalas; mencegah banjir balasan atas
# backlog offline. 0 = tanpa batas. (Self-chat pemilik selalu dikecualikan.)
IBRA_REPLY_MAX_AGE=300

# --- Direktori data --------------------------------------------------------
IBRA_DATA_DIR=./.ibra
IBRA_LOG_LEVEL=info

# ==========================================================================
# Ibra X — contoh konfigurasi lingkungan
# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env.
# ==========================================================================

# --- Provider LLM (pilih minimal satu; bisa banyak sekaligus) ---------------
# Format umum: <PROVIDER>_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Endpoint OpenAI-compatible kustom (opsional)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Ollama lokal (tanpa API key)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- Agen default ----------------------------------------------------------
IBRA_PROVIDER=openrouter
IBRA_MODEL=anthropic/claude-sonnet-4.5
IBRA_TEMPERATURE=0.3
IBRA_MAX_STEPS=16
IBRA_MAX_TOKENS_PER_TURN=8000

# --- Server ----------------------------------------------------------------
IBRA_PORT=8787
IBRA_HOST=127.0.0.1
# Kunci untuk mengakses API HTTP lokal (kosongkan untuk menonaktifkan proteksi)
IBRA_API_TOKEN=

# --- Keamanan --------------------------------------------------------------
# Nomor/ID yang boleh berinteraksi dengan agen (pisahkan dengan koma).
# Kosongkan untuk mode "owner-only" (hanya chat milik sendiri).
IBRA_ALLOWLIST=
# Tingkat otonomi: readonly | suggest | auto | autonomous
IBRA_AUTONOMY=suggest

# Transkripsikan pesan suara otomatis (butuh provider yang mendukung audio)
IBRA_TRANSCRIBE=false

# --- Direktori data --------------------------------------------------------
IBRA_DATA_DIR=./.ibra
IBRA_LOG_LEVEL=info
